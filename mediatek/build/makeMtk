
      - name: Diagnose LK architecture
        run: |
          cd bootable/bootloader/lk

          echo "=== Architecture directories ==="
          find arch -maxdepth 2 -type f -name 'compile.mk' -print

          echo "=== Project configuration ==="
          find project -maxdepth 3 -type f -iname '*asus*' -print

          echo "=== Architecture references ==="
          grep -RInE 'ARCH|arch/\$\(ARCH\)/compile\.mk|arch/\$\{ARCH\}/compile\.mk' \
            makefile make project arch 2>/dev/null | head -200 || true

          echo "=== Build configuration ==="
          sed -n '75,110p' make/build.mk

      - name: Build LK
        run: |
          set -euo pipefail
          cd bootable/bootloader/lk

          make asus \
            TOOLCHAIN_PREFIX="$TOOLCHAIN_BIN/$TOOLCHAIN_PREFIX"
